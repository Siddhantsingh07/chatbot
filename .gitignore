# ============================================
# File: .gitignore
# Python
# ============================================

# Compiled Python bytecode caches (generated automatically when modules are imported)
__pycache__/

# Compiled Python files: .pyc (bytecode), .pyo (optimized), .pyd (Windows extensions)
*.py[cod]

# Python package build/metadata folders (created by setuptools when packaging)
*.egg-info/

# Virtual environment inside backend (contains installed pip packages - huge, reproducible via requirements.txt)
backend/venv/

# Virtual environment anywhere else in the repo (same reason as above)
venv/

# Environment variable files - contain secrets like the Gemini API key, NEVER commit these
.env

# ============================================
# Databases
# ============================================

# SQLite database files (university_chatbot.db etc.) - local runtime data, not source code
*.db

# Alternative SQLite file extension
*.sqlite3

# ============================================
# Node
# ============================================

# Installed npm packages (hundreds of MB - reproducible via package.json / package-lock.json)
node_modules/

# Vite production build output (generated by `npm run build`)
frontend/dist/

# Alternative build output folder (e.g. from Create React App)
frontend/build/

# ============================================
# Uploads / datasets
# ============================================

# User-uploaded dataset files (large, machine-specific, not part of the codebase)
uploaded_dataset/

# ============================================
# IDE
# ============================================

# VS Code workspace settings (personal editor preferences, differ per machine)
.vscode/

# JetBrains IDEs (PyCharm/IntelliJ) project config folder
.idea/

# ============================================
# OS
# ============================================

# macOS Finder metadata files (created on every folder macOS touches)
.DS_Store

# Windows Explorer thumbnail cache
Thumbs.db
